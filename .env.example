# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Default is 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection URI (e.g., MongoDB Atlas or local mongodb://localhost:27017/taskflow)
# If left empty, TaskFlow will automatically use its embedded persistent local storage engine!
MONGODB_URI=mongodb://localhost:27017/taskflow

# JSON Web Token (JWT) Secret Key for authenticating API requests
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production

# JWT Expiration Time (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d
